#!/bin/sh
# 推送前检查：禁止直接推送到主分支；任务分支上的新提交必须带人工确认尾注。
# 参数：$1 远程名，$2 远程地址；stdin：<本地 ref> <本地 sha> <远程 ref> <远程 sha>
MAIN="${WP_MAIN_BRANCH:-main}"
REMOTE="$1"
ZERO="0000000000000000000000000000000000000000"
PY=""
for c in python3 python py; do
  if command -v "$c" >/dev/null 2>&1 && "$c" -c "import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)" >/dev/null 2>&1; then
    PY="$c"; break
  fi
done
V=".cursor/skills/git-naming-conventions/scripts/validate_names.py"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/"$MAIN"|refs/heads/master)
      echo "pre-push: 不能直接推送到 $remote_ref，请通过 PR 合并。" >&2
      status=1; continue ;;
  esac
  [ "$local_sha" = "$ZERO" ] && continue   # 删除远程分支
  branch="${remote_ref#refs/heads/}"
  case "$branch" in
    */p[0-9]-[0-9][0-9]-*)
      [ -z "$PY" ] && { echo "pre-push: 找不到 Python 3.9+" >&2; status=1; continue; }
      if git rev-parse --verify -q "$REMOTE/$MAIN" >/dev/null; then
        "$PY" "$V" --range "$REMOTE/$MAIN..$local_sha" --require-trailers >/dev/null || {
          "$PY" "$V" --range "$REMOTE/$MAIN..$local_sha" --require-trailers | grep -v '^OK' >&2
          echo "pre-push: $branch 上有未经人工确认的提交（缺少 Task / Confirmed-by 尾注）。" >&2
          status=1
        }
      fi ;;
  esac
done
exit $status
