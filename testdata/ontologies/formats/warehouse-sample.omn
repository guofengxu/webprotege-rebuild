Prefix: owl: <http://www.w3.org/2002/07/owl#>
Prefix: rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
Prefix: rdfs: <http://www.w3.org/2000/01/rdf-schema#>
Prefix: xml: <http://www.w3.org/XML/1998/namespace>
Prefix: xsd: <http://www.w3.org/2001/XMLSchema#>
Prefix: : <http://example.org/wp-test/warehouse>



Ontology: <http://example.org/wp-test/warehouse>


Annotations: 
    rdfs:comment "Hand-written warehouse ontology for webprotege-rebuild tests."@en,
    rdfs:label "Warehouse sample"@en,
    rdfs:label "仓库示例"@zh

AnnotationProperty: rdfs:comment

    
AnnotationProperty: rdfs:label

    
Datatype: rdf:langString

    
Datatype: xsd:string

    
ObjectProperty: <http://example.org/wp-test/warehouse#contains>

    Annotations: 
        rdfs:label "contains"@en,
        rdfs:label "包含"@zh
    
    
ObjectProperty: <http://example.org/wp-test/warehouse#storedAt>

    Annotations: 
        rdfs:label "stored at"@en,
        rdfs:label "存放于"@zh
    
    Domain: 
        <http://example.org/wp-test/warehouse#HandlingUnit>
    
    Range: 
        <http://example.org/wp-test/warehouse#Location>
    
    
DataProperty: <http://example.org/wp-test/warehouse#code>

    Annotations: 
        rdfs:label "code"@en,
        rdfs:label "编码"@zh
    
    Domain: 
        <http://example.org/wp-test/warehouse#Location>
    
    Range: 
        xsd:string
    
    
Class: <http://example.org/wp-test/warehouse#Agv>

    Annotations: 
        rdfs:label "AGV"@en,
        rdfs:label "自动导引车"@zh
    
