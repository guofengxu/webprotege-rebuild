AnnotationAssertion(rdfs:label :RetrievalTask "Retrieval task"@en)
AnnotationAssertion(rdfs:label :RetrievalTask "出库任务"@zh)
SubClassOf(:RetrievalTask :Task)

# Class: <http://example.org/wp-test/warehouse#Sku> (SKU)

AnnotationAssertion(rdfs:label :Sku "SKU"@en)
AnnotationAssertion(rdfs:label :Sku "货品"@zh)

# Class: <http://example.org/wp-test/warehouse#StackerCrane> (Stacker crane)

AnnotationAssertion(rdfs:label :StackerCrane "Stacker crane"@en)
AnnotationAssertion(rdfs:label :StackerCrane "堆垛机"@zh)
SubClassOf(:StackerCrane :Equipment)

# Class: <http://example.org/wp-test/warehouse#StorageLocation> (Storage location)

AnnotationAssertion(rdfs:label :StorageLocation "Storage location"@en)
AnnotationAssertion(rdfs:label :StorageLocation "存储货位"@zh)
SubClassOf(:StorageLocation :Location)

# Class: <http://example.org/wp-test/warehouse#Task> (Task)

AnnotationAssertion(rdfs:label :Task "Task"@en)
AnnotationAssertion(rdfs:label :Task "作业任务"@zh)

# Class: <http://example.org/wp-test/warehouse#Warehouse> (Warehouse)

AnnotationAssertion(rdfs:label :Warehouse "Warehouse"@en)
AnnotationAssertion(rdfs:label :Warehouse "仓库"@zh)

# Class: <http://example.org/wp-test/warehouse#Workstation> (Workstation)

AnnotationAssertion(rdfs:label :Workstation "Workstation"@en)
AnnotationAssertion(rdfs:label :Workstation "工作站"@zh)

