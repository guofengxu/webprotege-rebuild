@prefix : <http://example.org/wp-test/warehouse#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/wp-test/warehouse#> .

<http://example.org/wp-test/warehouse> rdf:type owl:Ontology ;
                                        rdfs:comment "Hand-written warehouse ontology for webprotege-rebuild tests."@en ;
                                        rdfs:label "Warehouse sample"@en ,
                                                   "仓库示例"@zh .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/wp-test/warehouse#contains
:contains rdf:type owl:ObjectProperty ;
          rdfs:label "contains"@en ,
                     "包含"@zh .


###  http://example.org/wp-test/warehouse#storedAt
:storedAt rdf:type owl:ObjectProperty ;
          rdfs:domain :HandlingUnit ;
          rdfs:range :Location ;
          rdfs:label "stored at"@en ,
                     "存放于"@zh .


#################################################################
#    Data properties
#################################################################

###  http://example.org/wp-test/warehouse#code
:code rdf:type owl:DatatypeProperty ;
      rdfs:domain :Location ;
      rdfs:range xsd:string ;
      rdfs:label "code"@en ,
                 "编码"@zh .


#################################################################
#    Classes
#################################################################

###  http://example.org/wp-test/warehouse#Agv
:Agv rdf:type owl:Class ;
