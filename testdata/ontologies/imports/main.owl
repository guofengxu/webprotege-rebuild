<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://example.org/wp-test/imports/main#"
     xml:base="http://example.org/wp-test/imports/main"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://example.org/wp-test/imports/main">
        <owl:imports rdf:resource="http://example.org/wp-test/imports/a"/>
        <owl:imports rdf:resource="http://example.org/wp-test/imports/b"/>
    </owl:Ontology>
    <owl:Class rdf:about="http://example.org/wp-test/imports/main#MainConcept">
        <rdfs:label xml:lang="en">Main concept</rdfs:label>
    </owl:Class>
</rdf:RDF>
