Prefix(:=<http://example.org/wp-test/axioms#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(swrlb:=<http://www.w3.org/2003/11/swrlb#>)

Ontology(<http://example.org/wp-test/axioms-all-types>

Declaration(Class(:Person))
Declaration(Class(:Man))
Declaration(Class(:Woman))
Declaration(Class(:Adult))
Declaration(Class(:Grown))
Declaration(ObjectProperty(:hasParent))
Declaration(ObjectProperty(:hasFather))
Declaration(ObjectProperty(:hasDad))
Declaration(ObjectProperty(:hasMother))
Declaration(ObjectProperty(:hasBiologicalMother))
Declaration(ObjectProperty(:hasChild))
Declaration(ObjectProperty(:hasAncestor))
Declaration(ObjectProperty(:hasSpouse))
Declaration(ObjectProperty(:knows))
Declaration(DataProperty(:hasAge))
Declaration(DataProperty(:hasName))
Declaration(DataProperty(:hasGivenName))
Declaration(DataProperty(:hasFullName))
Declaration(DataProperty(:hasWeight))
Declaration(AnnotationProperty(:note))
Declaration(NamedIndividual(:alice))
Declaration(NamedIndividual(:bob))
Declaration(NamedIndividual(:carol))
Declaration(NamedIndividual(:aliceAlias))
Declaration(Datatype(:AdultAge))

SubClassOf(:Man :Person)
SubClassOf(:Woman :Person)
EquivalentClasses(:Adult ObjectIntersectionOf(:Person :Grown))
DisjointClasses(:Man :Woman)
DisjointUnion(:Person :Man :Woman)

SubObjectPropertyOf(:hasFather :hasParent)
SubObjectPropertyOf(:hasMother :hasParent)
SubObjectPropertyOf(:hasBiologicalMother :hasMother)
EquivalentObjectProperties(:hasDad :hasFather)
DisjointObjectProperties(:hasFather :hasMother)
ObjectPropertyDomain(:hasParent :Person)
ObjectPropertyRange(:hasParent :Person)
InverseObjectProperties(:hasParent :hasChild)
FunctionalObjectProperty(:hasFather)
InverseFunctionalObjectProperty(:hasBiologicalMother)
SymmetricObjectProperty(:hasSpouse)
AsymmetricObjectProperty(:hasParent)
TransitiveObjectProperty(:hasAncestor)
ReflexiveObjectProperty(:knows)
IrreflexiveObjectProperty(:hasParent)
SubObjectPropertyOf(ObjectPropertyChain(:hasParent :hasParent) :hasAncestor)

SubDataPropertyOf(:hasGivenName :hasName)
EquivalentDataProperties(:hasFullName :hasName)
DisjointDataProperties(:hasAge :hasWeight)
DataPropertyDomain(:hasAge :Person)
DataPropertyRange(:hasAge :AdultAge)
FunctionalDataProperty(:hasAge)

SubAnnotationPropertyOf(:note rdfs:comment)
AnnotationPropertyDomain(:note :Person)
AnnotationPropertyRange(:note xsd:string)

ClassAssertion(:Person :alice)
ObjectPropertyAssertion(:hasSpouse :alice :bob)
NegativeObjectPropertyAssertion(:hasSpouse :alice :carol)
DataPropertyAssertion(:hasAge :alice "30"^^xsd:integer)
NegativeDataPropertyAssertion(:hasAge :alice "1"^^xsd:integer)
SameIndividual(:alice :aliceAlias)
DifferentIndividuals(:alice :bob)
HasKey(:Person () (:hasAge))
DatatypeDefinition(:AdultAge DatatypeRestriction(xsd:integer xsd:minInclusive "18"^^xsd:integer xsd:maxInclusive "120"^^xsd:integer))

AnnotationAssertion(rdfs:label :Person "人"@zh)
AnnotationAssertion(rdfs:label :Person "Person"@en)
AnnotationAssertion(:note :Person "人员"@zh)
AnnotationAssertion(:note :Person "person"@en)

ClassAssertion(:Person _:anon1)
ObjectPropertyAssertion(:knows :alice _:anon1)

DLSafeRule(
    Body(
        ClassAtom(:Person Variable(:x))
        DataPropertyAtom(:hasAge Variable(:x) Variable(:age))
        BuiltInAtom(swrlb:greaterThan Variable(:age) "17"^^xsd:integer)
    )
    Head(
        ClassAtom(:Adult Variable(:x))
    )
)

)
