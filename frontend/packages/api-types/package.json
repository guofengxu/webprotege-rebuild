{
  "name": "@wp/api-types",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "gen": "openapi-typescript ../../../docs/api/openapi.json -o src/schema.d.ts",
    "check": "openapi-typescript ../../../docs/api/openapi.json -o src/schema.d.ts --check"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
